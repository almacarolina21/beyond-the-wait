# Local settings for Beyond the Wait. Copy to .env (git-ignored) only if you want
# LIVE Claude explanations. Never commit .env or paste the key into chat, screenshots,
# or the browser.
#
# The key is read ONLY when live mode is switched on for a run:
#     BTW_AI_MODE=live streamlit run app/streamlit_app.py
# BTW_AI_MODE is deliberately NOT read from this file, so having a key here never
# turns on billable API calls by itself. Without it the app uses DEMO (mock) mode.
ANTHROPIC_API_KEY=

# Optional: model for live explanations (default claude-opus-5-5).
# BTW_CLAUDE_MODEL=claude-sonnet-5-5
