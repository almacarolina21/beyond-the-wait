# ---------------------------------------------------------------
# Secrets — NEVER commit these
# ---------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
secrets/
.streamlit/secrets.toml

# ---------------------------------------------------------------
# Python virtual environments
# ---------------------------------------------------------------
.venv/
venv/
env/
ENV/
.python-version

# ---------------------------------------------------------------
# Python build / cache artifacts
# ---------------------------------------------------------------
__pycache__/
*.py[cod]
*.so
*.egg-info/
.eggs/
build/
dist/
pip-wheel-metadata/

# ---------------------------------------------------------------
# Testing and coverage
# ---------------------------------------------------------------
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
.mypy_cache/
.ruff_cache/

# ---------------------------------------------------------------
# Data — generated artifacts are reproducible, so don't commit them.
# Public raw downloads are re-fetched by script; small processed
# reference tables MAY be committed deliberately (see data/README.md).
# ---------------------------------------------------------------
data/public/raw/*
!data/public/raw/.gitkeep
data/synthetic/*
!data/synthetic/.gitkeep
# The verified SIMULATED results bundle (~140 KB) is committed so a fresh clone
# can run the dashboard without the 6-minute rebuild. It is fictional model
# output, fingerprint-checked by the dashboard on load.
!data/synthetic/experiments/
evals/results/*
!evals/results/.gitkeep

# NOTE ON PRIVACY: .gitignore is NOT a privacy control. It matches file
# names, not contents, so it cannot detect or block patient information.
# This project's privacy protection is its data scope: only public
# aggregate data and synthetic data are ever used (see data/README.md).

# ---------------------------------------------------------------
# Notebooks, editors, OS
# ---------------------------------------------------------------
.ipynb_checkpoints/
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# Logs (Claude API calls may log prompts/responses)
logs/
*.log
